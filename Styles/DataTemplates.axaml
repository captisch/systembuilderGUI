<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:systembuilderGUI.Models"
                    xmlns:vm="using:systembuilderGUI.ViewModels"
                    xmlns:conv="using:systembuilderGUI.Converters">

    <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
    
    <!-- Templates for editable Fields -->
    
    <!-- OpenString -->
    <DataTemplate x:Key="OpenString" x:DataType="models:ConfigItem">
        <TextBox Text="{Binding Value}"/>
    </DataTemplate>
    
    <!-- Boolean -->
    <DataTemplate x:Key="Boolean" x:DataType="models:ConfigItem">
        <CheckBox>
            <CheckBox.IsChecked>
                <Binding Path="Value" 
                         Mode="TwoWay" 
                         Converter="{StaticResource StringToBoolConverter}"/>
            </CheckBox.IsChecked>
        </CheckBox>
    </DataTemplate>
    
    <!-- OptionList -->
    <DataTemplate x:Key="OptionList" x:DataType="models:ConfigItem">
        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Value, Mode=TwoWay}"
                  VerticalAlignment="Center"/>
    </DataTemplate>
    
    <!-- Integer -->
    <DataTemplate x:Key="Integer" x:DataType="models:ConfigItem">
        <TextBox Text="{Binding Value, 
                        Mode=TwoWay, 
                        UpdateSourceTrigger=LostFocus}"
                 Watermark="z. B. 1500, 1.5e3, 2E+6" 
                 VerticalAlignment="Center"/>
    </DataTemplate>
    
    <!-- FilePath | Deactivated for now-->
    <DataTemplate x:Key="FilePath" x:DataType="models:ConfigItem">
        <StackPanel Orientation="Horizontal">
            <Button Content="Choose..."
                    Command="{Binding Path=$parent[UserControl].((vm:SystemBuilderContentViewModel)DataContext).ChooseOutputDirectoryOfConfigCommand}"
                    CommandParameter="{Binding .}"
                    VerticalAlignment="Center"
                    IsEnabled="False"/>
            <TextBox IsEnabled="False" 
                     Text="{Binding Value, Mode=TwoWay}"
                     VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    
    <!-- Default -->
    <DataTemplate x:Key="Default" x:DataType="models:ConfigItem">
        <TextBox Text="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"/>
    </DataTemplate>
    
    <models:ConfigItemTemplateSelector 
        x:Key="TemplateSelector"
        OpenString="{StaticResource OpenString}"
        Boolean="{StaticResource Boolean}"
        Integer="{StaticResource Integer}"
        OptionList="{StaticResource OptionList}"
        FilePath="{StaticResource FilePath}"
        Default="{StaticResource Default}"
        />
    
    <DataTemplate x:Key="ConfigHeaderTemplate">
        <Grid Background="{StaticResource ThemeElevatedBrush}"
              DockPanel.Dock="Top"
              ColumnSpacing="8"
              Margin="2"
              ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemName"/>
                <ColumnDefinition Width="400" SharedSizeGroup="ItemValue"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemDefinition"/>
            </Grid.ColumnDefinitions>
                                
            <TextBlock Grid.Column="0" Text="Parameter" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Value" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Description" FontSize="16" HorizontalAlignment="Center"/>
        </Grid>
    </DataTemplate>
    
    <!-- Template for Configuration Items -->
    <DataTemplate x:Key="ConfigItemTemplate" DataType="models:ConfigItem">
        <Grid ColumnSpacing="8" IsEnabled="{Binding Access}" Margin="2" ShowGridLines="True">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemName"/>
                <ColumnDefinition Width="400" SharedSizeGroup="ItemValue"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemDefinition"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock 
                Grid.Column="0" 
                Text="{Binding Name}" 
                VerticalAlignment="Center"/>
            <TextBlock 
                Grid.Column="2" 
                Text="{Binding Description}" 
                VerticalAlignment="Center"/>
            <ContentControl 
                Grid.Column="1" 
                Content="{Binding}" 
                ContentTemplate="{StaticResource TemplateSelector}"
                VerticalAlignment="Center"/>
            
        </Grid>
    </DataTemplate>
    
    <!-- Template for Moduleports -->
    <DataTemplate x:Key="PortTemplate" DataType="models:Port">
        <Grid Name="PortTemplateGrid"
              Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition SharedSizeGroup="SizeGroupWidth" />
                <ColumnDefinition SharedSizeGroup="SizeGroupName"/>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="2" HorizontalAlignment="Center" Text="{Binding Direction}"/>
            <TextBlock Grid.Column="1" Margin="2" HorizontalAlignment="Center" Text="{Binding Type}"/>
            <TextBlock Grid.Column="2" Margin="4 2" HorizontalAlignment="Center" Text="{Binding Width}"/>
            <TextBlock Grid.Column="3" Margin="4 2" HorizontalAlignment="Center" Text="{Binding Name}" TextWrapping="Wrap"/>
            <Grid Grid.Column="4" ColumnDefinitions="*,*,*">
                <RadioButton Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4" Padding="0"
                             GroupName="{Binding Name}"
                             IsChecked="{Binding RouteToSOC}"
                             IsEnabled="{Binding $parent[ItemsControl].((models:SubModule)DataContext).IsExternalModule}"/>
                <RadioButton Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4" Padding="0"
                             GroupName="{Binding Name}"
                             IsChecked="{Binding RouteToWrapper}"
                             IsEnabled="{Binding $parent[ItemsControl].((models:SubModule)DataContext).IsExternalModule}"/>
                <RadioButton Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4" Padding="0"
                             IsChecked="{Binding NoRoute}"
                             GroupName="{Binding Name}"
                             IsEnabled="{Binding $parent[ItemsControl].((models:SubModule)DataContext).IsExternalModule}"/>
            </Grid>
        </Grid>
    </DataTemplate>
    
    <!-- Template for Moduleparameter -->
    <DataTemplate x:Key="ParameterTemplate" DataType="models:Parameter">
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="SizeGroupParamName" />
                <ColumnDefinition SharedSizeGroup="SizeGroupParamValue" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="{Binding Name}"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Center" Text="{Binding Value}"/>
            <TextBlock Grid.Column="2" />
        </Grid>
    </DataTemplate>
    
    <!-- Template for SubModule -->
    <DataTemplate x:Key="SubModuleTemplate" DataType="models:SubModule">
        <Expander Margin="3"
                  Padding="0">
            <Expander.Header>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Instance}"/>
                        <TextBlock Text=" (" Foreground="{DynamicResource ThemeControlHighBrush}"/>
                        <TextBlock Text="{Binding Module.Name}" Foreground="{DynamicResource ThemeControlHighBrush}"/>
                        <TextBlock Text=")" Foreground="{DynamicResource ThemeControlHighBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Right"
                            Content="Copy"
                            Command="{Binding Path=$parent[UserControl].((vm:SystemBuilderContentViewModel)DataContext).CopySubModuleCommand}"
                            CommandParameter="{Binding .}"/>
                    <Button Grid.Column="2"
                        Margin="5"
                        HorizontalAlignment="Right"
                        Content="Remove"
                        Command="{Binding Path=$parent[UserControl].((vm:SystemBuilderContentViewModel)DataContext).RemoveSubModuleFromConfigCommand}"
                        CommandParameter="{Binding .}"/>
                </Grid>
                
            </Expander.Header>
            <StackPanel>
                <Grid ColumnDefinitions="200,*" 
                      ColumnSpacing="8"
                      Margin="10"
                      HorizontalAlignment="Stretch">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Instance name"/>
                    <TextBox Grid.Column="1"
                             VerticalAlignment="Center"
                             Text="{Binding Instance}"/>
                </Grid>
                <Grid ColumnDefinitions="200,*" 
                      ColumnSpacing="8"
                      Margin="10"
                      HorizontalAlignment="Stretch">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Module name"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                             Text="{Binding Module.Name}"/>
                </Grid>
                <Grid ColumnDefinitions="200,*" 
                      ColumnSpacing="8"
                      Margin="10"
                      HorizontalAlignment="Stretch">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="External Submodule"/>
                    <CheckBox Grid.Column="1" 
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsExternalModule}"/>
                </Grid>
                
                <Expander HorizontalAlignment="Stretch"
                          Margin="5">
                    <Expander.Header>
                        <TextBlock Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Parameters ("/>
                                <TextBlock Text="{Binding Module.Parameters.Count}"/>
                                <TextBlock Text="):"/>
                            </StackPanel>
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel>
                        <Grid
                            Margin="2,10"
                            Background="{DynamicResource ThemeAccentBrush2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="SizeGroupParamName" />
                                <ColumnDefinition SharedSizeGroup="SizeGroupParamValue" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="Name"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="Value"/>
                            <TextBlock Grid.Column="2" Background="{DynamicResource ThemeBackgroundBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Module.Parameters}"
                                      ItemTemplate="{StaticResource ParameterTemplate}"/>
                    </StackPanel>
                </Expander>
                
                <Expander HorizontalAlignment="Stretch"
                          Margin="5">
                    <Expander.Header>
                        <TextBlock Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ports ("/>
                                <TextBlock Text="{Binding Module.Ports.Count}"/>
                                <TextBlock Text="):"/>
                            </StackPanel>
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <Grid Name="PortHeaderGrid"
                              Margin="2,5"
                              Background="{DynamicResource ThemeAccentBrush2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition SharedSizeGroup="SizeGroupWidth"/>
                                <ColumnDefinition SharedSizeGroup="SizeGroupName"/>
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Direction" />
                            <TextBlock Grid.Column="1" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Type"/>
                            <TextBlock Grid.Column="2" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Width"/>
                            <TextBlock Grid.Column="3" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Name"/>
                            <Grid Grid.Column="4" RowDefinitions="*,*" >
                                <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Route to"/>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*,*">
                                    <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="SoC"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Wrapper"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Ignore"/>
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Column="5" Background="{DynamicResource ThemeBackgroundBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Module.Ports}"
                                      ItemTemplate="{StaticResource PortTemplate}"/>
                    </StackPanel>
                </Expander>
                
                <Grid ColumnDefinitions="Auto,*"
                      Background="{DynamicResource ThemeControlLowBrush}"
                      >
                    <TextBlock Grid.Column="0"
                               Padding="10,0,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource ThemeControlHighBrush}"
                               Opacity="75"
                               Text="source: "/>
                    <SelectableTextBlock Grid.Column="1"
                                         FontSize="10"
                                         Foreground="{DynamicResource ThemeControlHighBrush}"
                                         Opacity="90"
                                         Text="{Binding Source}"/>
                </Grid>
            </StackPanel>
        </Expander>
    </DataTemplate>
    
    <!-- Template for OpenEye Parameter -->
    <DataTemplate x:Key="OeParamTemplate" DataType="models:OpenEyeParameter">
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="SizeGroupOeParamName" Width="2*"/>
                <ColumnDefinition SharedSizeGroup="SizeGroupOeParamValue" Width="*" />
                <ColumnDefinition SharedSizeGroup="SizeGroupOeParamDescription" Width="4*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="{Binding Name, Mode=TwoWay}"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Center" 
                     Text="{Binding Value, Mode=TwoWay}"
                     MaxLength="10"/>
            <TextBlock Grid.Column="2" HorizontalAlignment="Center" 
                       Text="{Binding Description}" TextWrapping="Wrap"/>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>