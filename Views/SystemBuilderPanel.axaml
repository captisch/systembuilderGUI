
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:systembuilderGUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:systembuilderGUI.Models"
             xmlns:conv="using:systembuilderGUI.Converters"
             x:Class="systembuilderGUI.Views.SystemBuilderPanel"
             x:DataType="vm:SystemBuilderContentViewModel">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="avares://systembuilderGUI/Styles/DataTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <StyleInclude Source="avares://systembuilderGUI/Styles/ButtonStyles.axaml"/>
    </UserControl.Styles>

        <Border Margin="0"
                BorderThickness="2">
            
            <DockPanel >
                
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Top"
                            Margin="8, 4"
                            Spacing="4">
                    <Button Classes = "Menu"
                            Content="Save"
                            Command="{Binding SaveConfigCommand}"/>
                    <Button Classes = "Menu"
                            Content="Load Config"
                            Command="{Binding LoadConfigCommand}"/>
                    <Button Classes = "Menu"
                            Content="Reset to Defaults"
                            Command="{Binding ResetDefaultsCommand}"/>
                    <Button Classes = "Menu"
                            Content="Run SystemBuilder"
                            Command="{Binding GenerateSystemCommand}"/>
                </StackPanel>
                
                <Separator DockPanel.Dock="Top" Margin="0" Background="{DynamicResource ThemeAccentBrush}" Height="2" />
                
                
                
                <TabControl Margin="0,5,0,2"
                            TabStripPlacement="Left">
                    <TabItem Header="Core Configuration">
                        <DockPanel Grid.IsSharedSizeScope="True">
                            
                            <ContentControl DockPanel.Dock="Top"
                                            Content="{Binding ConfigFile}"
                                            ContentTemplate="{StaticResource ConfigHeaderTemplate}"/>
                                
                            <ScrollViewer AllowAutoHide="True" 
                                          Padding="0,0,20,0"
                                          Background="{DynamicResource ThemeControlLowBrushBrush}">
                                <ItemsControl ItemsSource="{Binding ConfigFile.CoreItems}"
                                              ItemTemplate="{StaticResource ConfigItemTemplate}"/>
                            </ScrollViewer>
                            
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Interface Configuration">
                        <DockPanel Grid.IsSharedSizeScope="True">
                            
                            <ContentControl DockPanel.Dock="Top"
                                            Content="{Binding ConfigFile}"
                                            ContentTemplate="{StaticResource ConfigHeaderTemplate}"/>
                            
                            <ScrollViewer AllowAutoHide="True" 
                                          Padding="0,0,20,0">
                                <ItemsControl ItemsSource="{Binding ConfigFile.Interfaces}"
                                              ItemTemplate="{StaticResource ConfigItemTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Submodules">
                        <DockPanel>
                            <Button 
                                DockPanel.Dock="Top"
                                Content="Add Submodule"
                                Command="{Binding AddSubModulesToConfigCommand}"/>
                            <ScrollViewer 
                                DockPanel.Dock="Top"
                                HorizontalScrollBarVisibility="Visible"
                                AllowAutoHide="True"
                                Padding="0,0,10,0">
                                <ItemsControl ItemsSource="{Binding ConfigFile.subModules}"
                                              ItemTemplate="{StaticResource SubModuleTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="OpenEye">
                        <DockPanel Grid.IsSharedSizeScope="True">
                            <StackPanel DockPanel.Dock="Top">
                                <Button Content="Save Parameters" Command="{Binding SaveOpenEyeHeaderCommand}"/>
                                <Button Content="Load Parameters" Command="{Binding LoadOpenEyeParamsCommand}"/>
                                <Panel Margin="10"/>
                                <Button Content="Set up OpenEye" Command="{Binding MakeOpenEyeCommand}" />
                                <Button Content="Add current OpenEye to SoC" Command="{Binding AddOpenEyeToSocCommand}" />
                            </StackPanel>
                        
                            <DockPanel DockPanel.Dock="Top">
                            
                                <ContentControl DockPanel.Dock="Top"
                                                Content="{Binding OpenEyeConfig}"
                                                ContentTemplate="{StaticResource ConfigHeaderTemplate}"/>
                                
                                <ScrollViewer AllowAutoHide="True" 
                                              Padding="0,0,20,0"
                                              Background="{DynamicResource ThemeControlLowBrush}">
                                    <ItemsControl ItemsSource="{Binding OpenEyeConfig.Parameters}"
                                                  ItemTemplate="{StaticResource ConfigItemTemplate}"/>
                                </ScrollViewer>
                            
                            </DockPanel>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
        
</UserControl>
